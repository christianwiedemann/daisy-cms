{#
/**
 * @file
 * Grid component
 *
 * See component.wingsuit.yml for usage.
 */
#}

{% set grid_layout = grid_layout|default('1_equal') %}

{#
Defaults
#}
{% set gutter = gutter|default('default') %}

{% set attributes = attributes|default(create_attribute()).addClass(classes) %}

{% set attributes_set = create_attributes_set(
  {
    default: {},
    gutter: {
      none: '',
      small: 'gap-5',
      default: 'gap-7.5',
      large: 'gap-5 lg:gap-36.25',
    },
    grid_layout: {
      '1_equal': 'grid grid-cols-1 md:grid-cols-2',
      '2_equal': 'grid grid-cols-1 md:grid-cols-2',
      '2_66x33': 'grid grid-cols-1 lg:grid-cols-66/33',
      '2_33x66': 'grid grid-cols-1 lg:grid-cols-33/66',
      '2_75x25': 'grid grid-cols-1 md:grid-cols-75/25',
      '2_25x75': 'grid grid-cols-1 md:grid-cols-66/33 lg:grid-cols-25/75',
      '3_equal': 'grid grid-cols-1 lg:grid-cols-3',
      '3_25x50x25': 'grid grid-cols-1 lg:grid-cols-25/50/25',
      '2_25x25x50': 'grid grid-cols-1 lg:grid-cols-25/25/50',
      '4_equal': 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4',
      '5_equal': 'grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5'
    }
  },
  {
    gutter: gutter,
    grid_layout: grid_layout
  }
) %}

{#
Template
#}
{##}
<div {{ attributes.merge(attributes_set.gutter).merge(attributes_set.grid_layout ) }}>
  {% block cells %}
    {% for cell_counter, cell in cells %}
      {% block cell_outer %}
        <div>
          {{ cell }}
        </div>
      {% endblock %}
    {%- endfor -%}
  {% endblock %}
</div>
